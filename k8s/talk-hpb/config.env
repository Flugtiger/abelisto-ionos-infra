# Domain der IONOS Managed Nextcloud (ohne https://)
NC_DOMAIN=cloud.abelisto.de
# DNS-Name des HPB; A-Record muss auf die oeffentliche IP des HPB-Nodes zeigen
TALK_HOST=talk.abelisto.de
# TURN-Port (TCP+UDP) – muss oeffentlich erreichbar sein
TALK_PORT=3478
# info | debug | warn | error
AIO_LOG_LEVEL=info
# Janus nutzt diesen TURN-Server (Default waere NC_DOMAIN)
TURN_DOMAIN=talk.abelisto.de
